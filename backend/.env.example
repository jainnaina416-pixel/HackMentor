# ==============================================================================
# HackMentor RAG Backend - Environment Configuration
# ==============================================================================

# LLM Provider Configuration
# Choose one of: "groq", "google", "openai"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_TEMPERATURE=0.2

# LLM API Keys (Provide at least one for your chosen provider)
GROQ_API_KEY=gsk_your_groq_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=sk-proj-your_openai_api_key_here

# Embedding Model Configuration
# Options: "default" (lightweight offline deterministic vectorizer),
#          "huggingface" (local sentence-transformers/all-MiniLM-L6-v2),
#          "google" (models/embedding-001),
#          "openai" (text-embedding-3-small)
EMBEDDING_PROVIDER=default
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Storage & Database Directories
CHROMA_PERSIST_DIR=./backend/chroma_db
UPLOAD_DIR=./backend/uploads
DATABASE_PATH=./backend/hackmentor.db

# RAG & Chunking Parameters
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_RETRIEVAL_TOP_K=4

# Upload Limits (bytes: 10485760 = 10 MB)
MAX_UPLOAD_SIZE_BYTES=10485760

# CORS Allowed Origins (comma-separated list for frontend)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
